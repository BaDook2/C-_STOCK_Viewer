<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StockViewer</AssemblyName>
    <RootNamespace>StockViewer.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.1</Version>
    <Product>StockViewer</Product>
    <Description>국내·미국 주식과 ETF의 가격을 작은 한 줄 팝업으로 표시하는 Avalonia 데스크톱 앱</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StockViewer.Core/StockViewer.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <Target Name="OmitNativeDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
