<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StockViewer</AssemblyName>
    <RootNamespace>StockViewer.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.2.1</Version>
    <Product>StockViewer</Product>
    <Description>국내·미국 주식과 ETF의 가격을 작은 한 줄 팝업으로 표시하는 Avalonia 데스크톱 앱</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StockViewer.Core/StockViewer.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(IntermediateOutputPath)native/libStockViewerDesktop.dylib" Link="libStockViewerDesktop.dylib"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="BuildMacDesktopObserver" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="Native/DesktopSelection.m;../scripts/build_desktop_observer.py"
          Outputs="$(IntermediateOutputPath)native/libStockViewerDesktop.dylib">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/build_desktop_observer.py&quot; --runtime &quot;$(RuntimeIdentifier)&quot; --output &quot;$(IntermediateOutputPath)native/libStockViewerDesktop.dylib&quot;" />
  </Target>
  <Target Name="OmitNativeDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
