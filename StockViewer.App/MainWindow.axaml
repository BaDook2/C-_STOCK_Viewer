<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:StockViewer.Core" x:Class="StockViewer.Desktop.MainWindow"
        Title="StockViewer" Width="286" Height="80" MinWidth="0" MinHeight="0" WindowStartupLocation="CenterScreen"
        WindowDecorations="None" CanResize="False" TransparencyLevelHint="Transparent" Background="Transparent">
  <Border Name="SearchCard" Margin="4" CornerRadius="8" Background="{DynamicResource CanvasBrush}"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="9,3,9,8">
    <Grid RowDefinitions="22,5,30">
      <Grid Background="Transparent" ColumnDefinitions="*,Auto">
        <Border Name="DragArea" Grid.ColumnSpan="2" Background="Transparent" PointerPressed="DragHeader" />
        <CheckBox Name="DisplayName" FontSize="11" IsChecked="True" HorizontalAlignment="Left"
                  VerticalAlignment="Center" Click="DisplayNameChanged" ToolTip.Tip="이후 새로 여는 팝업에 종목 이름을 표시합니다.">
          <TextBlock Text="종목이름 Display" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </CheckBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="SaveLayoutButton" Classes="icon" Click="SaveLayoutClicked" ToolTip.Tip="가격창 배치 저장"
                  AutomationProperties.Name="가격창 배치 저장">
            <Canvas Width="16" Height="16">
              <Path Data="M 3,2 L 11,2 L 14,5 L 14,14 L 2,14 L 2,2 Z M 5,2 L 5,6 L 11,6 L 11,2 M 5,14 L 5,9 L 11,9 L 11,14"
                    Stroke="{Binding Foreground, ElementName=SaveLayoutButton}" StrokeThickness="1.3" StrokeJoin="Round" />
            </Canvas>
          </Button>
          <Button Name="LoadLayoutButton" Classes="icon" Click="LoadLayoutClicked" ToolTip.Tip="저장한 가격창 배치 불러오기"
                  AutomationProperties.Name="가격창 배치 불러오기">
            <Canvas Width="16" Height="16">
              <Path Data="M 2,7 L 2,3 L 6,3 L 8,5 L 13,5 L 13,7 M 2,14 L 4,7 L 15,7 L 13,14 Z"
                    Stroke="{Binding Foreground, ElementName=LoadLayoutButton}" StrokeThickness="1.3" StrokeJoin="Round" />
            </Canvas>
          </Button>
          <Button Name="ThemeButton" Classes="icon" Click="ToggleTheme" ToolTip.Tip="다크 모드로 전환"
                  AutomationProperties.Name="다크 모드로 전환">
            <Grid Width="16" Height="16">
              <Canvas Name="MoonIcon" Width="16" Height="16">
                <Path Data="M 13,9 A 6,6 0 1 1 7,3 A 4.5,4.5 0 0 0 13,9 Z"
                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" />
              </Canvas>
              <Canvas Name="SunIcon" Width="16" Height="16" IsVisible="False">
                <Ellipse Width="6" Height="6" Canvas.Left="5" Canvas.Top="5"
                         Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" />
                <Path Data="M 8,1 L 8,3 M 8,13 L 8,15 M 1,8 L 3,8 M 13,8 L 15,8 M 3,3 L 4.4,4.4 M 11.6,11.6 L 13,13 M 3,13 L 4.4,11.6 M 11.6,4.4 L 13,3"
                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineCap="Round" />
              </Canvas>
            </Grid>
          </Button>
          <Button Name="MinimizeButton" Classes="icon" Click="Minimize" ToolTip.Tip="최소화" AutomationProperties.Name="최소화">
            <Canvas Width="16" Height="16">
              <Path Data="M 3,8 L 13,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
            </Canvas>
          </Button>
          <Button Name="CloseButton" Classes="icon" ClickMode="Press" Click="CloseApp"
                  ToolTip.Tip="검색창 닫기 · 가격 팝업은 유지" AutomationProperties.Name="검색창 닫기">
            <Canvas Width="16" Height="16">
              <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
            </Canvas>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,6,46">
        <Grid>
          <TextBox Name="SearchBox" KeyDown="SearchKeyDown" LostFocus="SearchUnfocused"
                   AutomationProperties.Name="종목 이름 또는 코드" ToolTip.Tip="국내·미국 종목 이름·코드·티커·초성 입력 후 Enter" />
          <TextBlock Name="SearchPlaceholder" Text="종목 검색" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <Button Name="SearchButton" Grid.Column="2" FontSize="12" Padding="8,4" Click="SearchClicked"
                ToolTip.Tip="선택한 종목의 가격 팝업 열기"><TextBlock Text="검색" FontSize="13" /></Button>
        <Popup Name="Suggestions" PlacementTarget="{Binding #SearchBox}" Placement="Bottom" IsLightDismissEnabled="False"
               Topmost="False" TakesFocusFromNativeControl="False" WindowManagerAddShadowHint="False">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  Padding="3" Margin="0,3,0,0" Width="{Binding #SearchBox.Bounds.Width}">
            <StackPanel>
              <ListBox Name="SearchResults" MaxHeight="160" BorderThickness="0" Padding="0" Background="Transparent"
                       Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="종목 검색 결과">
                <ListBox.ItemTemplate><DataTemplate DataType="core:Stock">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayCode}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="7,0,0,0" />
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Name="NoResults" Text="검색 결과 없음" FontSize="11" Margin="7,9"
                         Foreground="{DynamicResource TextMutedBrush}" IsVisible="False" />
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Grid>
  </Border>
</Window>
