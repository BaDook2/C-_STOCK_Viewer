<Window x:Class="StockViewer.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="시세 설정" Width="340" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
  <Border Margin="5" CornerRadius="9" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
    <StackPanel>
      <Grid Background="Transparent" MouseLeftButtonDown="DragHeader">
        <TextBlock Text="공개 시세" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Click="Cancel" ToolTip="닫기" AutomationProperties.Name="설정 닫기"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
      </Grid>
      <TextBlock Text="네이버 공개 시세 · API 키 불필요" FontSize="12" Margin="0,12,0,6"/>
      <TextBlock Text="기본 확인 주기 2초. 제공처가 더 긴 간격을 지정하면 해당 간격을 따릅니다. 체결 갱신 속도는 보장되지 않습니다." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="17"/>
      <TextBlock x:Name="CurrentStatus" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/>
      <Button x:Name="ReconnectButton" Content="다시 연결" Click="Reconnect" HorizontalAlignment="Right" FontSize="12" Padding="12,6"/>
    </StackPanel>
  </Border>
</Window>
