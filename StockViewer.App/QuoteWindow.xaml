<Window x:Class="StockViewer.App.QuoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Height="32" SizeToContent="Width" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual" ShowInTaskbar="False" PreviewKeyDown="PopupKeyDown" PreviewMouseRightButtonDown="PopupRightClick">
  <Border x:Name="Card" Margin="2" CornerRadius="5" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,3" MouseLeftButtonDown="DragCard">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="StockName" FontSize="12" MaxWidth="104" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="PriceText" Text="—" FontSize="13" MinWidth="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="PercentText" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="12" MinWidth="48" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
  </Border>
</Window>
